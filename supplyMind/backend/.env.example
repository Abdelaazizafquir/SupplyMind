# ── SupplyMind Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for dev, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./supplymind.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/supplymind

# ── Authentication ────────────────────────────────────────────────────────────
# IMPORTANT: Generate a strong random secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_secret

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── LLM Coordinator ──────────────────────────────────────────────────────────
# Set LLM_PROVIDER to activate. Leave as "mock" to disable (no API key needed).
#
# Option A — Groq (Llama 3.3 70B, free 14,400 req/day, fastest):
#   1. Get free key at https://console.groq.com
#   2. Set LLM_PROVIDER=groq and GROQ_API_KEY below
#
# Option B — Google AI Studio (Gemini, free 1,500 req/day):
#   1. Get free key at https://aistudio.google.com/app/apikey
#   2. Set LLM_PROVIDER=gemini and GEMINI_API_KEY below
#
LLM_PROVIDER=mock
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
